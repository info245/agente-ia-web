{
  "name": "agente-ia-web-backend",
  "version": "1.0.0",
  "description": "Backend del agente IA web (Inbox Gateway + Orquestador)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "npx puppeteer browsers install chrome",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-isolation=none \"src/**/*.test.js\"",
    "check": "node --check src/server.js && node --check public-crm/app.js",
    "test:tmedia-agents": "node scripts/test-tmedia-agents.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "nodemailer": "^10.0.10",
    "openai": "^6.49.0",
    "pdfkit": "^0.17.2",
    "puppeteer": "^25.12.0"
  }
}
